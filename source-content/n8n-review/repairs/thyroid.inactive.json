      "parameters": {
        "jsCode": "// ============================================================\n//  Thyroid Assessment — Score Calculator\n//  Scoring tiers + logic preserved EXACTLY from the original\n//  multi-page form workflow. Only the data-source changed:\n//  the Typeform-style frontend posts ONE flat body so we read\n//  every q* answer from $input.first().json.body.\n// ============================================================\n\nconst data = $input.first().json.body || $input.first().json;\n\n// Score mapping\nconst scoreMap = {\n  'never': 0,\n  'occasionally': 1,\n  'frequently': 2,\n  'constantly': 3\n};\n\nfunction getScore(value) {\n  if (value === undefined || value === null || value === '') return 0;\n  const raw = Array.isArray(value) ? value[0] : value;\n  if (raw === undefined || raw === null || raw === '') return 0;\n  if (typeof raw === 'number') {\n    if (raw >= 0 && raw <= 3) return raw;\n    return 0;\n  }\n  const cleaned = String(raw).trim().toLowerCase();\n  if (cleaned in scoreMap) return scoreMap[cleaned];\n  if (cleaned.includes('constantly'))   return 3;\n  if (cleaned.includes('frequently'))   return 2;\n  if (cleaned.includes('occasionally')) return 1;\n  if (cleaned.includes('never'))        return 0;\n  const num = Number(cleaned);\n  if (!isNaN(num) && num >= 0 && num <= 3) return Math.round(num);\n  return 0;\n}\n\n// All 27 question field names (exact same list as the source workflow)\nconst fields = [\n  'q1_thinking_slow', 'q2_joint_stiffness', 'q3_bags_under_eyes',\n  'q4_dizziness', 'q5_nasal_congestion', 'q6_yellowing',\n  'q7_depression', 'q8_bowel_issues', 'q9_bloated_face',\n  'q10_weight_difficulty', 'q11_miss_meal', 'q12_memory_issues',\n  'q13_excessive_sleep', 'q14_pms', 'q15_not_sweating',\n  'q16_frequent_infections', 'q17_headaches', 'q18_slow_movements',\n  'q19_thinning_eyebrows', 'q20_concentration', 'q21_low_sex_drive',\n  'q22_feeling_cold', 'q23_dry_skin_hair', 'q24_morning_fatigue',\n  'q25_moody_irritable', 'q26_puffy_eyelids', 'q27_cold_extremities'\n];\n\nconst scores = {};\nlet totalScore = 0;\nconst warnings = [];\n\nfor (const field of fields) {\n  const rawValue = data[field];\n  const score = getScore(rawValue);\n  scores[field] = { raw: rawValue, type: typeof rawValue, score: score };\n  totalScore += score;\n  if (rawValue === undefined || rawValue === null || rawValue === '') {\n    warnings.push(field + ' is missing');\n  }\n}\n\n// Client's exact scoring tiers — preserved verbatim\nlet resultNum, resultLabel, resultContent;\nif (totalScore <= 9) {\n  resultNum = 1;\n  resultLabel = 'Unlikely';\n  resultContent = 'Low thyroid function is unlikely.';\n} else if (totalScore <= 22) {\n  resultNum = 2;\n  resultLabel = 'Possible';\n  resultContent = 'Low thyroid function is possible. You may consider using the Broda Barnes basal metabolic temperature test to learn more. If you are concerned, consider discussing your symptoms with your healthcare provider and taking a simple blood test to measure your thyroid hormone levels.';\n} else if (totalScore <= 39) {\n  resultNum = 3;\n  resultLabel = 'Likely';\n  resultContent = 'Low thyroid function is likely. Consider discussing your symptoms and concerns with your healthcare provider and taking a simple blood test to measure your thyroid hormone levels.';\n} else {\n  resultNum = 4;\n  resultLabel = 'Very Likely';\n  resultContent = 'Low thyroid function is very likely. Consult your healthcare provider. A blood test to measure your thyroid hormone levels is recommended.';\n}\n\nconst landingPageUrl = 'https://www.hrt.org/score-total?type=th&score=' + totalScore;\n\nreturn [{ json: {\n  patientName:  data.first_name   || '',\n  patientEmail: data.email        || '',\n  mailingList:  data.mailing_list || '',\n  totalScore,\n  resultNum,\n  resultLabel,\n  resultContent,\n  landingPageUrl,\n  _debug_scores: scores,\n  _debug_warnings: warnings\n}}];\n"
      },
