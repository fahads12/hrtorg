      "parameters": {
        "jsCode": "const d = $input.first().json;\n// Escape only the dynamic name used in the HTML greeting.\nfunction escapePatientName(value) {\n  return String(value)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#39;');\n}\nconst greeting = d.patientName ? ('Dear ' + escapePatientName(d.patientName)) : 'Hi there';\nconst year = new Date().getFullYear();\n\nconst introText = `Every day 200 million men and women around the globe suffer with thyroid issues that negatively impact their quality of life. Another 27 million people don't even know they have a condition. Many suffer with fatigue, dry skin, memory loss, and joint aches, just like you.<br/><br/>While hormone replacement with prescription medication may be required to treat an underactive thyroid, a diet rich in iodine that includes navy beans, eggs, seafood, and potatoes may help support thyroid health as well. Boosting protein and eating fruits and vegetables such as blueberries, cherries, squash, and peas, provides important nutrients including antioxidants, zinc, and selenium. These elements may help regulate thyroid hormone activity and support a healthy immune system overall.<br/><br/>Please take a moment to consider thyroid testing through our home based, private, secure testing program, or from one of our participating partner labs.`;\n\nconst html = `<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\"><head>\n<meta http-equiv=\"content-type\" content=\"text/html; charset=utf-8\"/>\n<meta name=\"format-detection\" content=\"telephone=no\"/>\n<meta name=\"viewport\" content=\"width=device-width; initial-scale=1.0; maximum-scale=1.0; user-scalable=no;\"/>\n<meta http-equiv=\"x-ua-compatible\" content=\"IE=9; IE=8; IE=7; IE=EDGE\"/>\n<title></title>\n<!--[if mso]><style>* {font-family:sans-serif !important;}</style><![endif]-->\n<!--[if !mso]><!--><link href=\"https://fonts.googleapis.com/css?family='Open Sans':100,100i,200,200i,300,300i,400,400i,500,500i,600,600i,700,700i,800,800i,900,900i%7COpen+Sans:300,300i,400,400i,600,600i,700,700i,800,800i&display=swap\" rel=\"stylesheet\"/><!--<![endif]-->\n<style type=\"text/css\">\n#outlook a{padding:0}body{width:100%!important}.ReadMsgBody{width:100%}a{word-wrap:break-word}.ExternalClass{width:100%}.ExternalClass,.ExternalClass div,.ExternalClass font,.ExternalClass p,.ExternalClass span,.ExternalClass td{line-height:100%}a,blockquote,body,li,p,table,td{-ms-text-size-adjust:100%;-webkit-text-size-adjust:100%;mso-line-height-rule:exactly}body{margin:0;padding:0;height:100%!important;width:100%!important}.a_block{display:block;text-decoration:none;}.t_shadow_block{padding:15px;-webkit-box-shadow:0px 0px 5px 0px rgba(0,0,0,0.25);-webkit-border-radius:5px;border-radius:5px;}.t_block{padding-left:20px;padding-right:20px;padding-bottom:30px;padding-top:30px;}.blog_box{padding-top:10px;padding-bottom:10px;padding-left:5px;padding-right:5px;}table{mso-table-lspace:0;mso-table-rspace:0}img{border:0;line-height:100%;outline:0;text-decoration:none;-ms-interpolation-mode:bicubic;height:auto}\n@media screen and (max-width:480px){table[class=columns]{width:100%!important}th[class=force-col-th]{display:block;width:100%!important}img[class=imagescale]{max-width:100%!important;width:100%!important;height:auto!important}img[class=w183]{max-width:120px!important;width:100%!important;height:auto!important}img[class=w159]{max-width:300px!important;width:100%!important;height:auto!important}}\n</style></head>\n<body style=\"-moz-text-size-adjust:100%;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;background-color:#fff;\">\n<table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\"><tr><td align=\"center\" bgcolor=\"#FFFFFF\" valign=\"top\">\n<table width=\"600\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" align=\"center\" class=\"columns\">\n\n<tr><td style=\"padding:20px;text-align:center\"><a href=\"https://www.hrt.org/\" target=\"_blank\" style=\"font-family:'Montserrat Black',sans-serif;font-size:32px;text-decoration:none;color:#000000;\">HRT.org</a></td></tr>\n\n<tr><td><img alt=\"\" border=\"0\" class=\"imagescale\" height=\"12\" src=\"https://cdn.prod.website-files.com/632a33dda7f9eaa9ed6897ea/63555c3912c18d245aac811e_Thyroid-Disorders%E2%80%94Testing-and-Treatment-p-2000.jpeg\" style=\"width:678px;max-width:678px;height:auto;\" width=\"600\">\n</td></tr>\n\n<tr bgcolor=\"#f8f8f8\"><td style=\"padding-left:20px;padding-right:20px;padding-top:35px;\">\n<table width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"min-width:100%;\">\n<tr><td style=\"line-height:25px;padding-bottom:5px;\"><div align=\"center\" style=\"font-size:20px;font-family:'Montserrat Black',sans-serif;color:#000\">Your Assessment Results</div></td></tr>\n<tr><td style=\"line-height:125%;padding-bottom:30px;\"><div align=\"center\" style=\"color:#484848;font-size:14px;font-family:'Open Sans',sans-serif;font-weight:normal;\">Assessment Score: <b>${d.totalScore}</b></div></td></tr>\n<tr><td style=\"line-height:125%;padding-bottom:30px;\"><div align=\"center\" style=\"color:#484848;font-size:14px;font-family:'Open Sans',sans-serif;font-weight:300;line-height:1.6\">${d.resultContent}</div></td></tr>\n</table></td></tr>\n\n<tr><td bgcolor=\"#1b83d5\" style=\"padding-top:30px;padding-bottom:30px;padding-left:20px;padding-right:20px;\" align=\"center\">\n<table border=\"0\" cellspacing=\"0\" cellpadding=\"0\" align=\"center\" class=\"columns-th\"><tr>\n<th width=\"20\" valign=\"middle\" style=\"vertical-align:middle;font-weight:normal;\" class=\"force-col-th\"><div style=\"line-height:10px;height:10px;\"></div></th>\n<th valign=\"middle\" style=\"vertical-align:middle;font-weight:normal;\" class=\"force-col-th\" align=\"center\">\n<table border=\"0\" cellspacing=\"0\" cellpadding=\"0\" align=\"center\"><tr>\n<td bgcolor=\"#feb92c\" style=\"padding-left:20px;padding-right:20px;padding-bottom:10px;padding-top:10px;\" align=\"center\">\n<a href=\"${d.landingPageUrl}\" target=\"_blank\" style=\"font-weight:bold;text-decoration:none;color:#FFF;font-family:'Open Sans',sans-serif;font-size:18px;\">VIEW RESULTS ONLINE</a>\n</td></tr></table></th></tr></table></td></tr>\n\n<tr><td bgcolor=\"#ffffff\" style=\"padding-left:20px;padding-right:20px;padding-top:35px;padding-bottom:35px;\">\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\"><tbody><tr><td style=\"line-height:1.6;\">\n<div align=\"left\" style=\"color:#4e525e;font-size:14px;font-family:'Open Sans',sans-serif;font-weight:300;\">${greeting},<br/><br/>${introText}<br/><br/>Feel free to reach out to one of our healthcare specialists for a private consultation or contact us with any questions or concerns you have concerning your health.<br/><br/>We hope you feel better soon, and look forward to hearing from you.<br/><br/>Sincerely,<br/><b>The HRT.org Team</b></div>\n</td></tr></tbody></table></td></tr>\n\n<tr><td bgcolor=\"#f8f8f8\" style=\"padding-bottom:35px;\"><table><tr><td style=\"padding:35px 20px;\">\n<table width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"min-width:100%;\">\n<tr><td style=\"line-height:25px;padding-bottom:5px;\"><div align=\"center\" style=\"font-size:20px;font-family:'Montserrat Black',sans-serif;color:#000000;\">Suggested Lab Tests</div></td></tr>\n<tr><td style=\"line-height:125%\"><div align=\"center\" style=\"color:#484848;font-size:13px;font-family:'Open Sans',sans-serif;font-weight:normal;\">Easy & Convenient Test Kits</div></td></tr>\n</table></td></tr>\n\n<tr><td style=\"padding:10px 20px\">\n<table width=\"100%\" cellpadding=\"3px\" cellspacing=\"0\" style=\"min-width:100%;\"><tr><td bgcolor=\"#FFFFFF\" class=\"t_shadow_block\">\n<a href=\"https://store.hrt.org/products/thyroid-test-at-home-thyroid-test-kit-essentials-