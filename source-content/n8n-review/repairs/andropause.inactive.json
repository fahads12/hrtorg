      "parameters": {
        "jsCode": "// ============================================================\n//  Andropause Assessment — Score Calculator\n//  Based on the AMS (Aging Males' Symptoms) questionnaire.\n//  Each of the 10 questions is scored 0–4:\n//    never=0, occasionally=1, frequently=2, constantly=3\n//\n//  Scoring tiers:\n//    <= 7  → Result 1 (Low likelihood — minimal symptoms)\n//    > 7   → Result 2 (Moderate-to-high — symptoms present)\n//\n//  The Typeform-style frontend posts ONE flat JSON body so we\n//  read every q* answer from $input.first().json.body.\n// ============================================================\n\nconst data = $input.first().json.body || $input.first().json;\n\nconst scoreMap = {\n  'never': 0,\n  'occasionally': 1,\n  'frequently': 2,\n  'constantly': 3\n};\n\nfunction getScore(value) {\n  if (value === undefined || value === null || value === '') return 0;\n  const raw = Array.isArray(value) ? value[0] : value;\n  if (raw === undefined || raw === null || raw === '') return 0;\n  if (typeof raw === 'number') {\n    if (raw >= 0 && raw <= 3) return raw;\n    return 0;\n  }\n  const cleaned = String(raw).trim().toLowerCase();\n  if (cleaned in scoreMap) return scoreMap[cleaned];\n  if (cleaned.includes('constantly'))   return 3;\n  if (cleaned.includes('frequently'))   return 2;\n  if (cleaned.includes('occasionally')) return 1;\n  if (cleaned.includes('never'))        return 0;\n  const num = Number(cleaned);\n  if (!isNaN(num) && num >= 0 && num <= 3) return Math.round(num);\n  return 0;\n}\n\n// All 10 andropause question field names\nconst fields = [\n  'q1_falling_asleep',\n  'q2_decreased_enjoyment',\n  'q3_losing_height',\n  'q4_strength_endurance',\n  'q5_sex_drive',\n  'q6_sports_performance',\n  'q7_depressed_grumpy',\n  'q8_lack_of_energy',\n  'q9_work_performance',\n  'q10_erection_difficulty'\n];\n\nconst scores = {};\nlet totalScore = 0;\nconst warnings = [];\n\nfor (const field of fields) {\n  const rawValue = data[field];\n  const score = getScore(rawValue);\n  scores[field] = { raw: rawValue, type: typeof rawValue, score: score };\n  totalScore += score;\n  if (rawValue === undefined || rawValue === null || rawValue === '') {\n    warnings.push(field + ' is missing');\n  }\n}\n\n// Scoring tiers — matched exactly to the original Make.com blueprint logic\n// (score <= 7 → Result 1, score > 7 → Result 2)\nlet resultNum, resultLabel, resultContent;\nif (totalScore <= 7) {\n  resultNum = 1;\n  resultLabel = 'Low Likelihood';\n  resultContent = 'Andropause is unlikely to be significantly impacting your health at this time. Your symptom score is low. However, testosterone levels can decline gradually with age — if you notice changes in energy, mood, or sexual function in the future, consider getting tested.';\n} else {\n  resultNum = 2;\n  resultLabel = 'Symptoms Present';\n  resultContent = 'Your score suggests that andropause may be affecting your quality of life. Many of the symptoms you are experiencing — such as decreased energy, reduced libido, mood changes, and diminished physical performance — can be linked to declining testosterone levels. We strongly recommend a hormone panel to assess your current levels and discuss your options with one of our healthcare specialists.';\n}\n\nconst landingPageUrl = 'https://www.hrt.org/score-total?type=an&score=' + totalScore;\n\nreturn [{ json: {\n  patientName:  data.first_name   || '',\n  patientEmail: data.email        || '',\n  mailingList:  data.mailing_list || '',\n  totalScore,\n  resultNum,\n  resultLabel,\n  resultContent,\n  landingPageUrl,\n  _debug_scores: scores,\n  _debug_warnings: warnings\n}}];\n"
      },
