cal-align:middle;font-weight:normal;\" class=\"force-col-th\" align=\"center\">\n<table border=\"0\" cellspacing=\"0\" cellpadding=\"0\" align=\"center\"><tr>\n<td bgcolor=\"#feb92c\" style=\"padding-left:20px;padding-right:20px;padding-bottom:10px;padding-top:10px;\" align=\"center\">\n<a href=\"${d.landingPageUrl}\" target=\"_blank\" style=\"font-weight:bold;text-decoration:none;color:#FFF;font-family:'Open Sans',sans-serif;font-size:18px;\">VIEW RESULTS ONLINE</a>\n</td></tr></table></th></tr></table></td></tr>\n\n<tr><td bgcolor=\"#ffffff\" style=\"padding-left:20px;padding-right:20px;padding-top:35px;padding-bottom:35px;\">\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\"><tbody><tr><td style=\"line-height:1.6;\">\n<div align=\"left\" style=\"color:#4e525e;font-size:14px;font-family:'Open Sans',sans-serif;font-weight:300;\">${greeting},<br/><br/>${introText}<br/><br/>Feel free to reach out to one of our healthcare specialists for a private consultation or contact us with any questions or concerns you have concerning your health.<br/><br/>We hope you feel better soon, and look forward to hearing from you.<br/><br/>Sincerely,<br/><b>The HRT.org Team</b></div>\n</td></tr></tbody></table></td></tr>\n\n<tr><td bgcolor=\"#f8f8f8\" style=\"padding-bottom:35px;\"><table><tr><td style=\"padding:35px 20px;\">\n<table width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"min-width:100%;\">\n<tr><td style=\"line-height:25px;padding-bottom:5px;\"><div align=\"center\" style=\"font-size:20px;font-family:'Montserrat Black',sans-serif;color:#000000;\">Suggested Lab Tests</div></td></tr>\n<tr><td style=\"line-height:125%\"><div align=\"center\" style=\"color:#484848;font-size:13px;font-family:'Open Sans',sans-serif;font-weight:normal;\">Easy &amp; Convenient Test Kits</div></td></tr>\n</table></td></tr>\n\n<tr><td style=\"padding:10px 20px\">\n<table width=\"100%\" cellpadding=\"3px\" cellspacing=\"0\" style=\"min-width:100%;\"><tr><td b