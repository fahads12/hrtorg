# Copy this file to .env.local. Secrets belong ONLY on this server.
# ADD YOUR OPENAI KEY LATER HERE. Never put it in public/ or browser storage.
OPENAI_API_KEY=
# Leave blank until verified in YOUR account with npm run models.
# Intended model family: GPT Luna. No automatic model substitution.
OPENAI_MODEL=
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
# Comma-separated HTTPS origins allowed to embed the widget.
WIDGET_ORIGINS=https://hrt.org,https://store.hrt.org
# Generate a long random token before enabling remote admin refresh.
ADMIN_TOKEN=
# 0 disables the in-process scheduler. Use an external scheduler on multi-instance hosts.
SYNC_INTERVAL_HOURS=24
# In-memory server conversation lifetime; no conversation files or logs.
SESSION_TTL_MINUTES=30
MAX_SESSIONS=500
CATALOG_FRESH_MINUTES=15
# Set only behind a known reverse proxy; number of trusted hops, 0 for local.
TRUST_PROXY_HOPS=0
